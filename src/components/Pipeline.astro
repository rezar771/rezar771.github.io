---
// A model/data pipeline as a row of stages joined by animated flow lines.
// The order is real: each project's stages are listed in execution order.
interface Props { steps: string[]; compact?: boolean }
const { steps, compact = false } = Astro.props;
---
<ol class:list={['pipe', { compact }]} aria-label="Pipeline">
  {steps.map((s, i) => (
    <li style={`--i:${i}`}>
      <span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
      <span class="lbl">{s}</span>
    </li>
  ))}
</ol>

<style>
  .pipe {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 0;
    counter-reset: s;
  }
  li { position: relative; display: grid; gap: 8px; align-content: start; padding-right: 14px; min-width: 0; }
  li::before {
    content: ''; display: block; width: 12px; height: 12px; border-radius: 50%;
    border: 2px solid var(--accent, var(--heat)); background: var(--bg);
    position: relative; z-index: 1;
    animation: node 4.8s calc(var(--i) * 0.6s) infinite;
  }
  li:not(:last-child)::after {
    content: ''; position: absolute; left: 14px; right: 2px; top: 5px; height: 2px;
    background:
      linear-gradient(90deg, var(--accent, var(--heat)) 0 40%, transparent 40%) 0 0 / 14px 2px repeat-x,
      color-mix(in oklab, var(--line-strong) 70%, transparent);
    animation: flow 1.2s linear infinite;
    opacity: .75;
  }
  .idx { font-size: 10px; color: var(--fg-3); letter-spacing: .08em; }
  .lbl { font-size: 0.85rem; line-height: 1.3; color: var(--fg); overflow-wrap: anywhere; }
  .compact .lbl { font-size: 0.72rem; color: var(--fg-2); overflow-wrap: normal; hyphens: auto; }
  .compact .idx { display: none; }
  @keyframes flow { to { background-position: 14px 0, 0 0; } }
  @keyframes node {
    0%, 70%, 100% { background: var(--bg); box-shadow: none; }
    8% { background: var(--accent, var(--heat)); box-shadow: 0 0 12px var(--accent, var(--heat)); }
  }
  @media (max-width: 720px) {
    .pipe:not(.compact) { grid-auto-flow: row; gap: 14px; }
    .pipe:not(.compact) li { grid-template-columns: 12px auto 1fr; align-items: center; gap: 12px; padding: 0; }
    .pipe:not(.compact) li:not(:last-child)::after { left: 5px; top: 18px; width: 2px; height: 22px; right: auto;
      background: linear-gradient(180deg, var(--accent, var(--heat)) 0 40%, transparent 40%) 0 0 / 2px 14px repeat-y; animation: flowv 1.2s linear infinite; }
    .compact li:nth-child(n + 4) { display: none; }
    .compact li:nth-child(3)::after { display: none; }
  }
  @keyframes flowv { to { background-position: 0 14px; } }
</style>
