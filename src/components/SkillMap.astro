---
// Skill ↔ project map: pick a skill and the projects that use it light up.
// Counts are computed from each project's stack, so the map can't drift from the work.
import { projects } from '../data/projects';

const counts = new Map<string, number>();
for (const p of projects) for (const s of p.stack) counts.set(s, (counts.get(s) ?? 0) + 1);
const skills = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const maxCount = skills[0]?.[1] ?? 1;
---
<div class="map" id="skill-map">
  <div class="skills" role="group" aria-label="Skills">
    {skills.map(([s, n]) => (
      <button type="button" class="sk" data-skill={s} aria-pressed="false" style={`--w:${0.35 + 0.65 * (n / maxCount)}`}>
        <span>{s}</span><span class="n mono num">{n}</span>
      </button>
    ))}
  </div>
  <ul class="plist" aria-live="polite">
    {projects.map((p) => (
      <li data-stack={p.stack.join('|')} style={`--accent:${p.accent}`}>
        <a href={`/projects/${p.slug}`}>
          <span class="sw" aria-hidden="true"></span>
          <span class="pt">{p.title}</span>
          <span class="py mono">{p.year}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const root = document.getElementById('skill-map');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.sk')];
    const rows = [...root.querySelectorAll<HTMLLIElement>('.plist li')];
    let pinned: string | null = null;
    const apply = (skill: string | null) => {
      root.classList.toggle('filtering', !!skill);
      rows.forEach((r) => r.classList.toggle('on', !!skill && r.dataset.stack!.split('|').includes(skill)));
      buttons.forEach((b) => b.classList.toggle('active', b.dataset.skill === skill));
    };
    buttons.forEach((b) => {
      b.addEventListener('pointerenter', () => { if (!pinned) apply(b.dataset.skill!); });
      b.addEventListener('pointerleave', () => { if (!pinned) apply(null); });
      b.addEventListener('click', () => {
        pinned = pinned === b.dataset.skill ? null : b.dataset.skill!;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.skill === pinned)));
        apply(pinned);
      });
    });
  }
</script>

<style>
  .map { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .skills { display: flex; flex-wrap: wrap; gap: 8px; }
  .sk {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    padding: 7px 12px; border-radius: 999px; border: 1px solid var(--line);
    background: color-mix(in oklab, var(--heat) calc(var(--w) * 14%), var(--bg-raised));
    color: var(--fg); font: 500 0.85rem/1.2 var(--font-body);
    transition: border-color .2s, background .2s, transform .3s var(--ease-out);
  }
  .sk:hover { transform: translateY(-1px); border-color: var(--line-strong); }
  .sk.active { background: var(--heat); border-color: var(--heat); color: var(--heat-ink); }
  .n { font-size: 11px; color: var(--fg-3); }
  .sk.active .n { color: inherit; opacity: .75; }

  .plist { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--line); position: sticky; top: 80px; }
  .plist li { border-bottom: 1px solid var(--line); transition: opacity .25s; }
  .plist a { display: grid; grid-template-columns: 10px 1fr auto; gap: 12px; align-items: center; padding: 11px 4px; text-decoration: none; }
  .sw { width: 10px; height: 10px; border-radius: 2px; background: var(--accent); transition: transform .3s var(--ease-out), box-shadow .3s; }
  .pt { font-size: 0.95rem; min-width: 0; }
  .py { font-size: 11px; color: var(--fg-3); }
  .filtering li { opacity: .28; }
  .filtering li.on { opacity: 1; }
  .filtering li.on .sw { transform: scale(1.35); box-shadow: 0 0 10px var(--accent); }
  .plist a:hover .pt { color: var(--heat); }
  @media (max-width: 820px) { .map { grid-template-columns: 1fr; } .plist { position: static; } }
</style>
