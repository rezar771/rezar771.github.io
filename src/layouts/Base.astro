---
import '../styles/global.css';
import cv from '../data/cv.json';

interface Props { title?: string; description?: string; path?: string }
const {
  title = `${cv.name} — AI / ML Engineer`,
  description = 'AI/ML engineer in Torino building computer vision, generative and LLM systems that ship: virtual try-on, anomaly detection, grounded RAG and local agents.',
  path = Astro.url.pathname,
} = Astro.props;
const canonical = new URL(path, Astro.site).href;
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
  { href: '/cv', label: 'CV' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person', name: cv.name, jobTitle: cv.title,
      address: { '@type': 'PostalAddress', addressLocality: 'Torino', addressCountry: 'IT' },
      alumniOf: 'Politecnico di Torino', sameAs: [cv.github, cv.linkedin],
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Home">
          <span class="dot" aria-hidden="true"></span>
          <span>Amirreza Rahimi</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
        <button class="theme" id="theme-toggle" type="button" aria-label="Toggle color theme">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
        </button>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="wrap foot">
        <div>
          <p class="foot-name">{cv.name}</p>
          <p class="foot-sub mono">AI / ML Engineer · Torino, Italy</p>
        </div>
        <div class="foot-links">
          <a href={`mailto:${cv.email}`}>{cv.email}</a>
          <a href={cv.github} target="_blank" rel="noopener">GitHub</a>
          <a href={cv.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href="/Amirreza_Rahimi_CV.pdf">CV (PDF)</a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; z-index: 50; background: var(--heat); color: var(--heat-ink); padding: 8px 12px; border-radius: 6px; }
  .skip:focus { left: 16px; }
  body::before { content: ''; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 10; background: var(--bg); }
  .topbar {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 24px; height: 60px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 700 1rem/1 var(--font-display); letter-spacing: -0.01em; margin-right: auto; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, var(--heat-hot), var(--heat) 45%, var(--heat-cool)); box-shadow: 0 0 14px var(--heat); }
  nav { display: flex; gap: 22px; }
  nav a { text-decoration: none; color: var(--fg-2); font: 500 var(--step--1)/1 var(--font-mono); transition: color .2s; }
  nav a:hover { color: var(--fg); }
  .theme { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--fg-2); cursor: pointer; }
  .theme:hover { color: var(--fg); border-color: var(--line-strong); }
  .theme svg { width: 18px; height: 18px; }
  @media (max-width: 640px) { nav { gap: 14px; } nav a:nth-child(3) { display: none; } .brand span:last-child { display: none; } }

  .footer { border-top: 1px solid var(--line); padding-block: 40px calc(40px + env(safe-area-inset-bottom, 0px)); }
  .foot { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: end; }
  .foot-name { font: 700 var(--step-1)/1.2 var(--font-display); }
  .foot-sub { color: var(--fg-3); font-size: var(--step--1); margin-top: 6px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font: 500 var(--step--1)/1.4 var(--font-mono); }
  .foot-links a { color: var(--fg-2); text-decoration: none; }
  .foot-links a:hover { color: var(--heat); }
</style>
