---
import Base from '../../layouts/Base.astro';
import Pipeline from '../../components/Pipeline.astro';
import BarChart from '../../components/BarChart.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
interface Props { p: Project; next: Project }
const { p, next } = Astro.props;
const m = p.media;
---
<Base title={`${p.title} — Amirreza Rahimi`} description={p.tagline} path={`/projects/${p.slug}`}>
  <article style={`--accent:${p.accent}`}>
    <header class="head">
      <div class="wrap head-inner">
        <a class="back mono" href="/projects">← All projects</a>
        <p class="meta mono">{p.year} · {p.context}</p>
        <h1>{p.title}</h1>
        <p class="tagline">{p.tagline}</p>
        <div class="tags">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
        {p.links.length > 0 && (
          <div class="links">{p.links.map((l) => <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}</div>
        )}
      </div>
    </header>

    {(m.video || m.cover) && (
      <div class="wrap">
        <figure class:list={['showcase', { portrait: m.portrait }]}>
          {m.video ? (
            <video src={m.video} poster={m.poster} autoplay muted loop playsinline controls preload="metadata"></video>
          ) : (
            <img src={m.cover} alt={`${p.title} screenshot`} />
          )}
        </figure>
      </div>
    )}

    {p.metrics.length > 0 && (
      <section class="wrap metrics" aria-label="Key results">
        {p.metrics.map((x) => (
          <div class="metric"><span class="v num">{x.value}</span><span class="l">{x.label}</span></div>
        ))}
      </section>
    )}

    <section class="wrap body">
      <div class="col">
        <h2 class="eyebrow">Overview</h2>
        <p class="lead">{p.summary}</p>
        <h2 class="eyebrow">The problem</h2>
        <p>{p.problem}</p>
        <h2 class="eyebrow">What I built</h2>
        <ul class="hl">{p.highlights.map((h) => <li>{h}</li>)}</ul>
      </div>
      <aside class="side">
        <h2 class="eyebrow">Stack</h2>
        <div class="stack">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
      </aside>
    </section>

    {p.pipeline.length > 0 && (
      <section class="wrap pipe-sec">
        <h2 class="eyebrow">Pipeline</h2>
        <div class="pipe-box"><Pipeline steps={p.pipeline} /></div>
      </section>
    )}

    {p.chart && (
      <section class="wrap chart-sec"><div class="chart-box"><BarChart chart={p.chart} /></div></section>
    )}

    {m.gallery && m.gallery.length > 1 && (
      <section class="wrap gallery-sec">
        <h2 class="eyebrow">Gallery</h2>
        <div class="gallery">
          {m.gallery.map((g) => (
            <a href={g.src} target="_blank" rel="noopener"><img src={g.src} alt={g.alt} loading="lazy" decoding="async" /></a>
          ))}
        </div>
      </section>
    )}

    <nav class="wrap next" aria-label="Next project">
      <a href={`/projects/${next.slug}`} style={`--accent:${next.accent}`}>
        <span class="eyebrow">Next project</span>
        <span class="nt">{next.title} →</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head {
    border-bottom: 1px solid var(--line);
    background: radial-gradient(60% 120% at 90% 0%, color-mix(in oklab, var(--accent) 18%, transparent), transparent 65%);
  }
  .head-inner { display: grid; gap: 16px; padding-block: clamp(40px, 7vw, 88px) clamp(36px, 5vw, 64px); }
  .back { font-size: 12px; color: var(--fg-3); text-decoration: none; }
  .back:hover { color: var(--accent); }
  .meta { font-size: 12px; color: var(--accent); letter-spacing: .06em; text-transform: uppercase; }
  h1 { font-size: var(--step-4); letter-spacing: -0.035em; max-width: 18ch; }
  .tagline { font-size: var(--step-1); color: var(--fg-2); max-width: 52ch; line-height: 1.45; }
  .tags, .links, .stack { display: flex; flex-wrap: wrap; gap: 8px; }
  .links { margin-top: 6px; }

  .showcase { margin: clamp(28px, 4vw, 48px) 0 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--bg-sunk); }
  .showcase video, .showcase img { width: 100%; height: auto; }
  .showcase.portrait { max-width: 420px; margin-inline: auto; }

  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 0; margin-top: clamp(28px, 4vw, 48px); }
  .metric { display: grid; gap: 6px; padding: 20px 20px 20px 0; border-top: 2px solid var(--accent); }
  .metric + .metric { padding-left: 20px; }
  .metric .v { font: 800 var(--step-3)/1 var(--font-display); letter-spacing: -0.03em; }
  .metric .l { font-size: 0.85rem; color: var(--fg-3); }
  @media (max-width: 560px) { .metric + .metric { padding-left: 0; } }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 280px); gap: clamp(32px, 6vw, 80px); padding-block: clamp(48px, 6vw, 80px) 0; }
  .col { display: grid; gap: 14px; max-width: 70ch; }
  .col .eyebrow:not(:first-child) { margin-top: 22px; }
  .col p { color: var(--fg-2); }
  .col .lead { color: var(--fg); font-size: var(--step-1); line-height: 1.5; }
  .hl { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .hl li { position: relative; padding-left: 24px; color: var(--fg-2); }
  .hl li::before { content: ''; position: absolute; left: 0; top: .62em; width: 12px; height: 2px; background: var(--accent); }
  .side { display: grid; gap: 12px; align-content: start; position: sticky; top: 90px; }
  @media (max-width: 860px) { .body { grid-template-columns: 1fr; } .side { position: static; } }

  .pipe-sec, .chart-sec, .gallery-sec { padding-top: clamp(48px, 6vw, 72px); display: grid; gap: 16px; }
  .pipe-box { padding: 28px 24px 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-raised); overflow-x: auto; }
  .chart-box { max-width: 860px; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .gallery a { display: block; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); aspect-ratio: 16 / 10; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
  .gallery a:hover img { transform: scale(1.04); }

  .next { padding-block: clamp(64px, 8vw, 112px); }
  .next a { display: grid; gap: 8px; text-decoration: none; padding-top: 24px; border-top: 1px solid var(--line); }
  .nt { font: 800 var(--step-3)/1.05 var(--font-display); letter-spacing: -0.03em; transition: color .25s; }
  .next a:hover .nt { color: var(--accent); }
</style>
